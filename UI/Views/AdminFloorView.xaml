<UserControl x:Class="Flexi2.Views.AdminFloorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="#0A0A12" Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2.2*"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT: ZONES -->
        <Border Grid.Column="0"
                Background="#141428"
                CornerRadius="16"
                BorderThickness="2"
                BorderBrush="#B400FF"
                Padding="16">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <DockPanel Margin="0,0,0,10">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="ACTIVITIES" Width="130" Margin="0,0,10,0" Command="{Binding BackToActivitiesCommand}"/>
                        <Button Content="HOME" Width="90" Command="{Binding BackCommand}"/>
                    </StackPanel>
                    <TextBlock Text="ADMIN • FLOOR PLAN"
                               Foreground="#00FF9C"
                               FontSize="20"
                               FontWeight="SemiBold"/>
                </DockPanel>

                <TextBlock Grid.Row="1"
                           Text="Zones"
                           Foreground="#00E5FF"
                           FontSize="16"
                           Margin="0,0,0,6"/>

                <StackPanel Grid.Row="3">
                    <TextBlock Text="New zone name" Foreground="#AAAADD" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding NewZoneName}" />

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="ADD ZONE"
                                Width="140"
                                Command="{Binding AddZoneCommand}"/>
                        <Button Content="DELETE ZONE"
                                Width="140"
                                Margin="10,0,0,0"
                                Command="{Binding DeleteZoneCommand}"/>
                    </StackPanel>

                    <!-- Error area -->
                    <TextBlock Text="{Binding Error}"
                               Foreground="#FF4D4D"
                               Margin="0,10,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <Border Grid.Row="4"
                        Margin="0,14,0,0"
                        Background="#0F0F1F"
                        CornerRadius="12"
                        BorderThickness="1"
                        BorderBrush="#2A2A55"
                        Padding="10">

                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top"
                                   Text="Zones list"
                                   Foreground="#CCCCFF"
                                   Margin="0,0,0,8"/>

                        <ListBox ItemsSource="{Binding Zones}"
                                 SelectedItem="{Binding SelectedZone}"
                                 DisplayMemberPath="Name"
                                 BorderThickness="0"
                                 Background="Transparent"/>
                    </DockPanel>
                </Border>
            </Grid>
        </Border>

        <!-- RIGHT: TABLES -->
        <Border Grid.Column="2"
                Background="#141428"
                CornerRadius="16"
                BorderThickness="2"
                BorderBrush="#00E5FF"
                Padding="16">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <TextBlock Text="Tables"
                           Foreground="#00E5FF"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Margin="0,0,0,10"/>

                <TextBlock Grid.Row="1"
                           Text="{Binding SelectedZone.Name, StringFormat=Selected zone: {0}}"
                           Foreground="#AAAADD"
                           FontSize="13"/>

                <StackPanel Grid.Row="3">
                    <TextBlock Text="New table name" Foreground="#AAAADD" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding NewTableName}" />

                    <Button Content="ADD TABLE"
                            Width="140"
                            Margin="0,10,0,0"
                            Command="{Binding AddTableCommand}"/>
                </StackPanel>

                <Border Grid.Row="4"
                        Margin="0,14,0,0"
                        Background="#0F0F1F"
                        CornerRadius="12"
                        BorderThickness="1"
                        BorderBrush="#2A2A55"
                        Padding="10">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="280"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>

                        <!-- Tables list -->
                        <DockPanel Grid.Column="0">
                            <TextBlock DockPanel.Dock="Top"
                                       Text="Tables list"
                                       Foreground="#CCCCFF"
                                       Margin="0,0,0,8"/>

                            <ListBox ItemsSource="{Binding Tables}"
                                     SelectedItem="{Binding SelectedTable}"
                                     BorderThickness="0"
                                     Background="Transparent">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#181833"
                                                CornerRadius="12"
                                                BorderThickness="1"
                                                BorderBrush="#B400FF"
                                                Padding="10"
                                                Margin="0,0,0,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition/>
                                                    <ColumnDefinition Width="120"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" Foreground="White" FontSize="15"/>
                                                    <TextBlock Text="{Binding PosX, StringFormat=X: {0:0}}" Foreground="#6666AA" FontSize="11"/>
                                                </StackPanel>

                                                <Button Grid.Column="1"
                                                        Content="DELETE"
                                                        Height="32"
                                                        Command="{Binding DataContext.DeleteTableCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                        CommandParameter="{Binding}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>

                        <!-- Layout editor -->
                        <DockPanel Grid.Column="2">
                            <TextBlock DockPanel.Dock="Top"
                                       Text="Layout (drag tables to position)"
                                       Foreground="#CCCCFF"
                                       Margin="0,0,0,8"/>

                            <Border Background="#0A0A12" CornerRadius="10" BorderThickness="1" BorderBrush="#2A2A55">
                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                    <Grid>
                                        <Canvas x:Name="LayoutCanvas" Width="1200" Height="700" Background="#0B0B16"/>
                                        <ItemsControl ItemsSource="{Binding Tables}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <Canvas Width="1200" Height="700"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemContainerStyle>
                                                <Style TargetType="ContentPresenter">
                                                    <Setter Property="Canvas.Left" Value="{Binding PosX}"/>
                                                    <Setter Property="Canvas.Top" Value="{Binding PosY}"/>
                                                </Style>
                                            </ItemsControl.ItemContainerStyle>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Thumb DragDelta="TableThumb_DragDelta" DragCompleted="TableThumb_DragCompleted"
                                                           Width="{Binding Width}" Height="{Binding Height}">
                                                        <Thumb.Template>
                                                            <ControlTemplate>
                                                                <Border Background="#181833" BorderThickness="2" BorderBrush="#00E5FF" CornerRadius="14">
                                                                    <Grid>
                                                                        <TextBlock Text="{Binding Name}" Foreground="White" FontSize="18" FontWeight="SemiBold"
                                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    </Grid>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Thumb.Template>
                                                    </Thumb>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </ScrollViewer>
                            </Border>
                        </DockPanel>
                    </Grid>
                </Border>

            </Grid>
        </Border>

    </Grid>
</UserControl>
