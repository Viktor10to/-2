<UserControl x:Class="Flexi2.Views.PaymentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="#0A0A12">
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Background="#121225" BorderThickness="0,0,0,2" BorderBrush="#00E5FF">
            <Grid Margin="18,0">
                <TextBlock Text="ПЛАЩАНЕ" Foreground="#00FF9C" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="BACK" Width="120" Command="{Binding BackCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="24">
            <Border Background="#10102A" CornerRadius="18" Padding="20" BorderThickness="1" BorderBrush="#2A2A50">
                <StackPanel>
                    <TextBlock Text="Метод" Foreground="White" FontSize="16" Margin="0,0,0,10"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Button Content="CASH" Width="120" Margin="0,0,12,0" Command="{Binding CashCommand}"/>
                        <Button Content="CARD" Width="120" Margin="0,0,12,0" Command="{Binding CardCommand}"/>
                        <Button Content="OTHER" Width="120" Command="{Binding OtherCommand}"/>
                    </StackPanel>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="Отстъпка %" Foreground="#B6C2FF"/>
                            <TextBox Text="{Binding DiscountPercentText, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Бакшиш" Foreground="#B6C2FF"/>
                            <TextBox Text="{Binding TipText, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Сума" Foreground="White" FontSize="16"/>
                        <TextBlock Grid.Column="1" Text="{Binding Subtotal, StringFormat={}{0:0.00} лв}" Foreground="#00FF9C" FontSize="16" FontWeight="Bold"/>
                    </Grid>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="За плащане" Foreground="White" FontSize="18" FontWeight="Bold"/>
                        <TextBlock Grid.Column="1" Text="{Binding Total, StringFormat={}{0:0.00} лв}" Foreground="#00FF9C" FontSize="18" FontWeight="Bold"/>
                    </Grid>

                    <Button Content="CONFIRM / CLOSE" Height="50" Command="{Binding ConfirmCommand}"/>

                    <TextBlock Text="{Binding Error}" Foreground="#FF4D6D" Margin="0,12,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
