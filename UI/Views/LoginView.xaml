<UserControl x:Class="Flexi2.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{StaticResource Bg1Brush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>

        <Border Style="{StaticResource NeonCard}" Margin="18">
            <StackPanel>
                <TextBlock Text="LOGIN" FontSize="28" FontWeight="Bold" Foreground="{StaticResource NeonCyanBrush}"/>
                <TextBlock Text="POS / ADMIN c PIN" Foreground="{StaticResource TextDimBrush}" Margin="0,6,0,18"/>

                <WrapPanel Margin="0,0,0,14">
                    <Button Content="POS" Width="120" Margin="0,0,12,0"
                            Style="{StaticResource NeonButton}"
                            Command="{Binding SelectPosCommand}"/>
                    <Button Content="ADMIN" Width="120"
                            Style="{StaticResource NeonButtonPurple}"
                            Command="{Binding SelectAdminCommand}"/>
                </WrapPanel>

                <TextBox Style="{StaticResource NeonTextBox}" Text="{Binding Pin}" Margin="0,0,0,10"/>

                <WrapPanel Margin="0,0,0,12">
                    <Button Content="ENTER" Width="160" Style="{StaticResource NeonButton}"
                            Command="{Binding EnterCommand}" Margin="0,0,12,0"/>
                    <Button Content="EXIT" Width="120" Style="{StaticResource NeonButtonPurple}"
                            Command="{Binding ExitCommand}"/>
                </WrapPanel>

                <TextBlock Text="{Binding Error}" Foreground="{StaticResource DangerBrush}" />
            </StackPanel>
        </Border>

        <Border Grid.Column="1" Style="{StaticResource NeonCard}" Margin="18">
            <StackPanel>
                <TextBlock Text="Демо кодове" FontSize="22" FontWeight="Bold" Foreground="{StaticResource NeonPurpleBrush}"/>
                <TextBlock Text="POS: 1111" Margin="0,14,0,0" Foreground="{StaticResource NeonCyanBrush}" FontSize="16"/>
                <TextBlock Text="ADMIN: 9999" Margin="0,6,0,0" Foreground="{StaticResource NeonPurpleBrush}" FontSize="16"/>
                <TextBlock Text="(ако не работи 9999 → изтрий flexi.db и стартирай пак)"
                           Margin="0,14,0,0" Foreground="{StaticResource TextDimBrush}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
