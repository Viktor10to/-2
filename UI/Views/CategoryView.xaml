<UserControl x:Class="Flexi2.Views.CategoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="#0A0A12">
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Border Background="#121225" BorderThickness="0,0,0,2" BorderBrush="#00E5FF">
            <Grid Margin="18,0">
                <TextBlock Text="CATEGORIES" Foreground="#00FF9C" FontSize="20" VerticalAlignment="Center"/>
                <Button Content="BACK" Command="{Binding BackCommand}" Width="120" HorizontalAlignment="Right"/>
            </Grid>
        </Border>

        <ItemsControl Grid.Row="1" ItemsSource="{Binding Categories}" Margin="20">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Width="220" Height="90" Margin="10"
                            Command="{Binding DataContext.OpenCategoryCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}"
                            BorderThickness="2" BorderBrush="#B400FF" Background="#181833">
                        <TextBlock Text="{Binding Name}" Foreground="White" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</UserControl>
